---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import LoadingScreen from '../components/LoadingScreen.astro';
import Hero from '../components/sections/Hero.astro';
import TechCarousel from '../components/TechCarousel.astro';
import ProjectAccordion from '../components/ProjectAccordion.astro';
import ContactForm from '../components/ContactForm.vue';
import avatarImg from '../assets/images/avatar.png';

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
  <LoadingScreen />
  <Hero />

  <!-- ============ PROFILE ============ -->
  <section id="profile" class="section bg-alt z-1 ow-hidden">
    <div class="container">
      <div class="section-header">
        <h2 data-animate>À propos</h2>
        <div class="separator-h separator-h-gradient" data-animate></div>
        <p class="section-description" data-animate>
          Développeur passionné par la création d'<span class="text-accent">
            applications modernes et performantes
          </span>.
        </p>
      </div>

      <div class="profile-content relative grid mi-auto">
        <div class="profile-identity flex flex-colai-center gap-6">
          <div class="profile-avatar z-50" data-animate>
            <video autoplay muted loop></video>
            <Image src={avatarImg} alt="Avatar Nocdev" class="profile-avatar-img" loading="lazy" />
          </div>

          <div class="profile-info grid gap-6">
            <!-- Location -->
            <div class="info-item flex ai-center gap-4" data-animate>
              <div class="info-icon grid pi-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
                  <path
                    d="M215.7 499.2C267 435 384 279.4 384 192C384 86 298 0 192 0S0 86 0 192c0 87.4 117 243 168.3 307.2c12.3 15.3 35.1 15.3 47.4 0zM192 128a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"
                  >
                  </path>
                </svg>
              </div>
              <div>
                <p class="info-label">Localisation</p>
                <p class="info-value">France · Remote</p>
              </div>
            </div>
            <!-- Education -->
            <div class="info-item flex ai-center gap-4" data-animate>
              <div class="info-icon flex ai-center jc-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512">
                  <path
                    d="M320 32c-8.1 0-16.1 1.4-23.7 4.1L15.8 137.4C6.3 140.9 0 149.9 0 160s6.3 19.1 15.8 22.6l57.9 20.9C57.3 229.3 48 259.8 48 291.9l0 28.1c0 28.4-10.8 57.7-22.3 80.8c-6.5 13-0.6 28.9 12.3 34.6c8.5 3.7 18.3 3.1 26.5-1.8c2.3-1.3 4.5-2.8 6.7-4.3c14.2-9.8 30.6-18.3 47.6-23.7c22.8-7.3 46.6-5.1 67.4 8l1.5 0.9c4.5 2.7 9.2 5.2 14 7.4C192.3 441.7 256.3 480 320 480s127.7-38.3 118.3-87.1c4.8-2.2 9.5-4.7 14-7.4l1.5-.9c20.8-13.1 44.6-15.3 67.4-8c17 5.4 33.4 13.9 47.6 23.7c2.2 1.5 4.4 3 6.7 4.3c8.2 4.9 18 5.5 26.5 1.8c12.9-5.7 18.8-21.6 12.3-34.6C602.8 349.7 592 320.4 592 292l0-28.1c0-32.1-9.3-62.6-25.7-88.3l57.9-20.9C633.7 179.1 640 170.1 640 160s-6.3-19.1-15.8-22.6L343.7 36.1C336.1 33.4 328.1 32 320 32zM128 408c0 35.3 85.96 64 192 64s192-28.7 192-64L512 288.8 354.9 346c-11.1 3.9-22.9 5.9-34.9 5.9s-23.8-2-34.9-5.9L128 288.8 128 408z"
                  >
                  </path>
                </svg>
              </div>
              <div class="education">
                <p class="info-label">Formation</p>
                <p class="info-value">Développeur d'application</p>
                <p class="info-sub">Openclassrooms · RNCP Niv. 6</p>
              </div>
            </div>
            <!-- Availability -->
            <div class="info-item flex ai-center gap-4" data-animate>
              <div class="info-icon flex ai-center jc-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
                  <path
                    d="M438.6 105.4c12.5 12.5 12.5 32.8 0 45.3l-256 256c-12.5 12.5-32.8 12.5-45.3 0l-128-128c-12.5-12.5-12.5-32.8 0-45.3s32.8-12.5 45.3 0L160 338.7 393.4 105.4c12.5-12.5 32.8-12.5 45.3 0z"
                  >
                  </path>
                </svg>
              </div>
              <div>
                <p class="info-label">Disponibilité</p>
                <div class="flex ai-center gap-2">
                  <p class="info-value">Disponible en freelance</p>
                  <div class="status-icon"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-coljc-center gap-4">
          <div class="chat-bubble" data-animate>
            <p>Hello ! Bienvenue sur Nocdev. 🦉</p>
          </div>
          <div class="chat-bubble" data-animate>
            <p>
              Développeur d'application web passionné par la tech, la conception d'interfaces modernes et les
              expériences utilisateur soignées.
            </p>
          </div>
          <div class="chat-bubble" data-animate>
            <p>
              Toujours à l'écoute de mes clients, j'apporte soin et rigueur à chaque projet pour livrer un résultat qui
              répond vraiment au besoin.
            </p>
          </div>
          <div class="chat-bubble" data-animate>
            <p>
              En veille constante, j'aime explorer de nouvelles approches pour trouver la meilleure solution technique.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMPETENCES ============ -->
  <section id="competences" class="section bg-surface relative">
    <div class="container">
      <div class="section-header">
        <h2 data-animate>Compétences</h2>
        <div class="separator-h separator-h-gradient" data-animate></div>
        <p class="section-description" data-animate>
          Technologies, outils et environnement que j'utilise pour créer des <span class="text-accent">
            applications modernes et performantes
          </span>.
        </p>
      </div>
    </div>
    <TechCarousel />
  </section>

  <!-- ============ PORTFOLIO ============ -->
  <section id="portfolio" class="section bg-alt">
    <div class="container">
      <div class="section-header">
        <h2 data-animate>Portfolio</h2>
        <div class="separator-h separator-h-gradient" data-animate></div>
        <p class="section-description" data-animate>
          Une sélection de <span class="text-accent">projets personnels et techniques</span> qui reflètent mon approche du
          développement.
        </p>
      </div>
      <ProjectAccordion />
      <!--<ProjectAccordion client:load />-->
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="section bg-surface">
    <div class="container">
      <div class="section-header">
        <h2 data-animate>Contact</h2>
        <div class="separator-h separator-h-gradient" data-animate></div>
        <p class="section-description" data-animate>
          Je suis <span class="text-accent">disponible en freelance</span> et toujours ouvert à de
          <span class="text-accent">nouvelles collaborations</span>.
        </p>
      </div>
      <div class="contact-form" data-animate>
        <ContactForm client:load />
      </div>
    </div>
  </section>
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('.profile-avatar video');
  // Display Video on Desktop
  if (video && window.matchMedia('(min-width: 577px)').matches) {
    const source = document.createElement('source');
    source.src = '/profile-video.mp4';
    source.type = 'video/mp4';
    video.appendChild(source);
    video.load();
  }

  // Star formation
  const starsContainer = document.querySelector<HTMLElement>('.stars');
  if (starsContainer) {
    // Grid with 5 columns and 5 rows = 25 stars evenly spaced
    const cols = 5,
      rows = 5;

    for (let row = 0; row < rows; row++) {
      for (let col = 0; col < cols; col++) {
        const star = document.createElement('span');
        star.className = 'star';
        star.textContent = '+';

        // Position within the cell + random offset (jitter)
        // → uniform distribution but natural appearance
        star.style.left = `${(col / cols) * 100 + Math.random() * (100 / cols)}%`;
        star.style.top = `${(row / rows) * 100 + Math.random() * (100 / rows)}%`;

        // Random delay to prevent all the stars from blinking at the same time
        star.style.animationDelay = `${Math.random() * 3}s`;

        starsContainer.appendChild(star);
      }
    }
  }
</script>
