---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../assets/styles/main.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  hasLoader?: boolean;
}
const { hasLoader = false } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <!-- LOADING SCREEN — anti-flash
         Script bloquant (is:inline) : doit s'exécuter avant le premier paint
         pour éviter que le loader clignote sur les visites déjà vues cette session. -->
    {
      hasLoader && (
        <script is:inline>
          if (!sessionStorage.getItem('loader')) {
            document.documentElement.classList.add('show-loader');
            document.documentElement.style.overflow = 'hidden';
          }
        </script>
      )
    }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/logo.svg" as="image" type="image/svg+xml" />
    <!-- <meta name="generator" content={Astro.generator} /> -->

    <title>Nocdev | Développeur freelance d'applications web modernes</title>
    <meta
      name="description"
      content="Développeur freelance spécialisé en applications web modernes avec Astro et Vue.js. Interfaces performantes, responsive et accessibles."
    />

    <!-- Open Graph -->
    <meta property="og:title" content="Nocdev | Développeur freelance d'applications web modernes" />
    <meta
      property="og:description"
      content="Développeur freelance spécialisé en applications web modernes avec Astro et Vue.js. Interfaces performantes, responsive et accessibles."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://nocdev.fr" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Nocdev" />
    <!-- <meta property="og:image" content="https://nocdev.fr/og-image.png" /> -->

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Canonical -->
    <link rel="canonical" href="https://nocdev.fr" />

    <!-- Schema.org -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Noctua",
        "url": "https://nocdev.fr",
        "jobTitle": "Développeur freelance d'applications web modernes",
        "description": "Développeur freelance spécialisé en applications web modernes avec Astro et Vue.js.",
        "knowsAbout": ["Astro", "Vue.js", "JavaScript", "TypeScript", "CSS", "HTML", "Linux", "Git", "Gsap", "Node.js"],
        "email": "contact@nocdev.fr"
      }
    </script>

    <style is:inline>
      [data-animate] {
        opacity: 0;
        visibility: hidden;
      }

      /* LOADING SCREEN — anti-flash
         Caché par défaut, montré uniquement si le script bloquant ci-dessus
         a posé .show-loader (doit rester critique/inline, voir commentaire plus haut). */
      #loading-screen {
        display: none;
      }

      html.show-loader #loading-screen {
        display: flex;
      }
    </style>
    <noscript>
      <style>
        [data-animate] {
          opacity: 1;
          visibility: visible;
        }
      </style>
    </noscript>
  </head>
  <body>
    <Header />
    <main role="main" class="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import { initLenis, initAnchorLinks } from '../utils/ScrollManager.ts';
      import { initAnimations } from '../utils/AnimationManager';

      window.addEventListener('DOMContentLoaded', () => {
        initLenis(); // 1. Smooth scroll first
        window.dispatchEvent(new Event('lenis:ready')); // 2. Lenis ready
        initAnchorLinks(); // 3. Anchor links
      });

      document.addEventListener('loader:done', () => {
        initAnimations();
      });
    </script>
  </body>
</html>
