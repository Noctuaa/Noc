---
interface Props {
  title: string;
  description: string;
  align?: 'left' | 'center';
}
const { title, description, align = 'left' } = Astro.props;
---

<div class:list={['section-header w-full flex flex-col gap-5', { 'ai-center text-center': align === 'center' }]}>
  <h2 class="uppercase" data-animate>{title}</h2>
  <hr class:list={['w-full', align === 'center' ? 'hr-gradient-center' : 'hr-gradient']} data-animate />
  <p class="section-lead w-full text-lg ink-2" data-animate>{description}</p>
</div>
