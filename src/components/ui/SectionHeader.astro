---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<div class="section-header w-full flex flex-col gap-3">
  <h2 data-animate>{title}</h2>
  <hr class="w-full" data-animate />
  <p class="section-lead w-full text-lg ink-2" data-animate>{description}</p>
</div>
