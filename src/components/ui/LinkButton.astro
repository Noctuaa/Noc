---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'cta' | 'link';
}
const { href, variant = 'link', class: className, ...rest } = Astro.props;
---

<a href={href} class={`btn-${variant} text-sm ink-1 font-bold rounded-sm c-pointer ${className ?? ''}`} {...rest}>
  <slot />
</a>
