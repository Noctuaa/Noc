---
import { Image } from 'astro:assets';
import weatherImg from '../assets/images/weather.webp';
import chaletsImg from '../assets/images/chalets.webp';
import type { ImageMetadata } from 'astro';
import Button from './ui/Button.astro';

type Project = {
  id: number;
  title: string;
  link: string;
  tags: string[];
  description: string;
  image: ImageMetadata;
};

// Portfolio projects list
const projects: Project[] = [
  {
    id: 1,
    title: 'SkyCast',
    link: 'https://skycast.nocdev.fr/',
    tags: ['Astro', 'Vue.js', 'MapLibre'],
    description:
      'Prévisions en temps réel, carte interactive et graphiques détaillés — une météo pensée pour la rapidité et la clarté.',
    image: weatherImg,
  },
  {
    id: 3,
    title: 'EstateHub',
    link: 'https://nocimmo.nocdev.fr/',
    tags: ['Vue.js', 'Laravel', 'MySQL'],
    description: 'Plateforme immobilière full-stack avec système de recherche avancée et gestion des annonces.',
    image: chaletsImg,
  },
];
---

<ul class="accordion flex gap-2 w-full">
  {
    projects.map((project) => (
      <li class="project-item relative flex flex-1 ai-end h-full border-sub rounded-lg ow-hidden c-pointer">
        <Image src={project.image} alt={project.title} class="project-img absolute w-full h-full object-cover" />
        <span class="title-vertical absolute text-2xl uppercase font-bold text-gradient">{project.title}</span>
        <div class="project-content flex flex-col gap-3 w-full p-6 opacity-0 backdrop-blur pe-none">
          <h3 class="project-title text-2xl font-bold ink-1">{project.title}</h3>
          <p class="project-description text-sm ink-2">{project.description}</p>
          <ul class="project-list-tags flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <li class="project-tag text-sm ink-2 rounded-sm">{tag}</li>
            ))}
          </ul>
          <Button
            href={project.link}
            variant="primary"
            class="as-end"
            target="_blank"
            aria-label={`Voir le projet ${project.title}`}
          >
            Voir <span>↗</span>
          </Button>
        </div>
      </li>
    ))
  }
</ul>

<script>
  const accordion = document.querySelector<HTMLElement>('.accordion');
  const desktopQuery = window.matchMedia('(min-width: 992px)');

  // Set active item
  const setActive = (item: Element) => {
    accordion?.querySelector<HTMLElement>('.project-item.active')?.classList.remove('active');
    item.classList.add('active');
  };

  accordion?.querySelector<HTMLElement>('.project-item')?.classList.add('active');

  accordion?.addEventListener('click', (e) => {
    const item = (e.target as Element).closest('.project-item');
    if (!item) return;
    setActive(item);
    if (!desktopQuery.matches) item.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  });

  const carouselObserver = new IntersectionObserver(
    (entries) => {
      if (desktopQuery.matches) return;
      entries.forEach((entry) => {
        if (entry.isIntersecting) setActive(entry.target);
      });
    },
    { root: accordion, threshold: 0.5 },
  );
  accordion?.querySelectorAll<HTMLElement>('.project-item').forEach((item) => {
    carouselObserver.observe(item);
  });
</script>
