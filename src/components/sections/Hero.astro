---
import Button from '../ui/Button.astro';
---

<section id="hero" class="section relative z-10 grid pi-center ow-hidden">
  <canvas class="stars-canvas absolute w-full h-full inset-0 pe-none" aria-hidden="true"></canvas>
  <div class="hero-aurora" aria-hidden="true"></div>
  <div class="hero-forest" aria-hidden="true"></div>
  <div class="container relative z-10">
    <div class="hero-content grid gap-3 text-center">
      <h1 class="mt-0 text-7xl">
        <span class="inline-block" data-animate>Développeur</span>
        <br />
        <span class="text-gradient inline-block" data-animate>d'application web.</span>
      </h1>
      <p class="hero-subtitle js-center text-lg ink-2" data-animate>
        Je transforme vos besoins en applications web modernes et performantes.
      </p>
      <Button href="#projects" variant="cta" class="js-center" aria-label="Explorer mes projets" data-animate
        >Explorer mes projets</Button
      >
    </div>
  </div>
</section>

<script>
  // Star formation — canvas starfield scoped to the Hero, scintillement asynchrone par étoile
  type Star = {
    x: number;
    y: number;
    r: number;
    p: number;
    s: number;
    g: boolean;
  };

  const starsCanvas = document.querySelector<HTMLCanvasElement>('.stars-canvas');
  if (starsCanvas) {
    const ctx = starsCanvas.getContext('2d')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0;
    let h = 0;
    let stars: Star[] = [];

    const resize = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      w = starsCanvas.clientWidth;
      h = starsCanvas.clientHeight;
      starsCanvas.width = w * dpr;
      starsCanvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(230, Math.round((w * h) / 7000));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.3 + 0.25,
        p: Math.random() * Math.PI * 2,
        s: Math.random() * 0.03 + 0.006,
        g: Math.random() < 0.16,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const star of stars) {
        if (!reduceMotion) star.p += star.s;
        ctx.globalAlpha = 0.32 + 0.68 * (0.5 + 0.5 * Math.sin(star.p));
        ctx.fillStyle = star.g ? '#8ff0d0' : '#dfe9ff';
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.r, 0, Math.PI * 2);
        ctx.fill();
      }
      if (!reduceMotion) requestAnimationFrame(draw);
    };

    // ResizeObserver plutôt qu'un simple event 'resize' : se redéclenche dès que
    // la taille réelle du Hero se stabilise (ex: 100svh mobile qui se résout après le premier paint).
    const observer = new ResizeObserver(() => resize());
    observer.observe(starsCanvas);
    draw();
  }
</script>
